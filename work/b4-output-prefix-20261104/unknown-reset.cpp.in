#include <cassert>
#include <cstdint>
#include <memory>
#include <vector>
#include <cstdio>
#include <type_traits>
#define TESTS_ENABLED
// Standalone control-flow model only. Real Core witnesses/queues are exercised
// by the engine doctests, which are not executed by this harness.
enum Error { OK, ERR_ALREADY_IN_USE, ERR_INVALID_PARAMETER, ERR_BUSY, ERR_INVALID_DATA, ERR_CANT_CREATE, ERR_UNAUTHORIZED };
struct RID {
 uint64_t value=0;
 bool is_null() const{return !value;}
 bool is_valid() const{return value;}
};
template<class T> struct BitField { int value=0; BitField()=default; BitField(T p):value(int(p)){} };
struct NativeDisposalWitness {
 enum class State {EMPTY,LIVE,ENQUEUED,RETURNED,UNKNOWN};
 struct Report {State state=State::EMPTY;uint64_t rid=0,serial=0;};
 std::shared_ptr<Report> cell;
};
struct Thread {static uint64_t get_caller_id(){return 1;}};
struct RenderingDevice {
 bool is_main_instance=true;
 uint64_t render_thread_id=1;
 enum StorageBufferUsage { STORAGE_BUFFER_USAGE_DISPATCH_INDIRECT=1 };
 uint32_t creates=0,fail_on=0,maintenance_calls=0;
 bool busy=false;
 Error maintenance_result=ERR_BUSY;
 std::vector<uint32_t> bytes,usages;
 std::vector<std::shared_ptr<NativeDisposalWitness::Report>> cells;
 Error _native_disposal_preflight() const {return !is_main_instance||render_thread_id!=Thread::get_caller_id()?ERR_UNAUTHORIZED:busy?ERR_BUSY:OK;}
 Error _native_disposal_storage_create(uint32_t n,BitField<StorageBufferUsage> u,RID &rid,NativeDisposalWitness&w) {
  ++creates;bytes.push_back(n);usages.push_back(u.value);
  if(creates==fail_on)return ERR_CANT_CREATE;
  rid.value=100+creates;w.cell=std::make_shared<NativeDisposalWitness::Report>();
  *w.cell={NativeDisposalWitness::State::LIVE,rid.value,1000+creates};cells.push_back(w.cell);return OK;
 }
 Error _native_disposal_free(const NativeDisposalWitness&w){
  if(busy)return ERR_BUSY;
  if(w.cell->state==NativeDisposalWitness::State::UNKNOWN)return ERR_INVALID_DATA;
  if(w.cell->state==NativeDisposalWitness::State::LIVE)w.cell->state=NativeDisposalWitness::State::ENQUEUED;
  return OK;
 }
 Error _native_disposal_observe(const NativeDisposalWitness&w,NativeDisposalWitness::Report&r)const {
  r=*w.cell;return r.state==NativeDisposalWitness::State::UNKNOWN?ERR_INVALID_DATA:OK;
 }
 Error _native_disposal_maintenance(){++maintenance_calls;return maintenance_result;}
 void returned(){for(auto &c:cells)if(c->state==NativeDisposalWitness::State::ENQUEUED)c->state=NativeDisposalWitness::State::RETURNED;}
};
namespace RendererRD {
struct ExternalOutputConfig { static Error checked_buffer_bytes(uint64_t,uint64_t,uint64_t,uint32_t&); };
}
/**************************************************************************/
/*  external_output_storage.h                                             */
/**************************************************************************/



class TestExternalOutputPrefixAccess;

namespace RendererRD {
class ParticlesStorage;

// Single-use, Core-owned allocation prefix, not an output lease or capability.
// No source enrollment, uniform-set factory, budget grant, publication or
// OutputReleased acknowledgement is provided here. The original ParticlesStorage
// owner must retain this object AND its budget charges until destroy_if_returned
// succeeds; UNKNOWN retains them permanently. The original K03 device-holder
// lease must keep RenderingDevice alive throughout retention (including UNKNOWN).
// This reference is not that lease. Never observe/maintain after device destruction.
// No destructor submits/free guesses.
class ExternalOutputStorage {
	friend class ParticlesStorage;
#ifdef TESTS_ENABLED
	friend class ::TestExternalOutputPrefixAccess;
#endif

	enum Role : uint32_t {
		CURRENT_RECORDS,
		PREVIOUS_RECORDS,
		OUTPUT_META,
		GUARD_SCRATCH,
		GUARD_STATUS,
		PROTECTED_COMMANDS,
		GEOMETRY_PROOF,
		RESOURCE_COUNT,
	};
	struct Resource {
		RID rid;
		NativeDisposalWitness witness;
		uint32_t bytes = 0;
	};
	struct ResourceReport {
		NativeDisposalWitness::Report native;
		uint32_t bytes = 0;
	};
	struct Report {
		ResourceReport resources[RESOURCE_COUNT];
		uint64_t total_bytes = 0; // Planned owned bytes only, not a budget grant.
		uint32_t created_count = 0;
		uint32_t live_count = 0;
		uint32_t enqueued_count = 0;
		uint32_t returned_count = 0;
		uint32_t unknown_count = 0;
		Error creation_error = OK;
		bool retirement_requested = false;
		bool all_driver_returned = false; // This prefix only, never OutputReleased.
	};

	RenderingDevice &device;
	Resource resources[RESOURCE_COUNT];
	uint64_t total_bytes = 0;
	Error creation_error = OK;
	bool attempted = false;
	bool retirement_requested = false;
	bool unknown = false;

	explicit ExternalOutputStorage(RenderingDevice &p_device) : device(p_device) {}
	ExternalOutputStorage(const ExternalOutputStorage &) = delete;
	ExternalOutputStorage &operator=(const ExternalOutputStorage &) = delete;
	~ExternalOutputStorage() = default; // Only controlled destroy after observation.

	// Mechanical allocation only. A future production caller still needs the
	// original source/operation and real budget admission BEFORE calling this.
	// They do not exist yet: no production acquire/seal path calls this method.
	Error allocate_instance192(uint32_t p_capacity, uint32_t p_surface_count);
	Error request_retirement();
	Error observe(Report &r_report);
	// Explicit delegation only. Scheduling/fences remain the original RD's job.
	Error maintenance();
	static Error destroy_if_returned(ExternalOutputStorage *&p_storage);
};
} // namespace RendererRD
namespace RendererRD {
Error ExternalOutputConfig::checked_buffer_bytes(uint64_t p_count, uint64_t p_stride, uint64_t p_device_limit, uint32_t &r_bytes) {
	if (p_count >= UINT32_MAX || (p_stride != 0 && p_count > UINT64_MAX / p_stride)) {
		return ERR_INVALID_PARAMETER;
	}
	const uint64_t bytes = p_count * p_stride;
	if (bytes > UINT32_MAX || bytes > p_device_limit) {
		return ERR_INVALID_PARAMETER;
	}
	r_bytes = uint32_t(bytes);
	return OK;
}

}
/**************************************************************************/
/*  external_output_storage.cpp                                           */
/**************************************************************************/



namespace RendererRD {

Error ExternalOutputStorage::allocate_instance192(uint32_t p_capacity, uint32_t p_surface_count) {
	if (attempted || retirement_requested) {
		return ERR_ALREADY_IN_USE;
	}
	if (p_capacity > (1u << 20) || p_surface_count == 0 || p_surface_count > 8) {
		return ERR_INVALID_PARAMETER;
	}
	const Error ready = device._native_disposal_preflight();
	if (ready != OK) {
		return ready;
	}
	// Compute every extent before any native creation. RD has no public maximum
	// storage-buffer-byte limit; actual allocation failure stays a native error.
	// Fixed control extents match ParticlesExternalGuard's Instance192 ABI.
	uint32_t bytes[RESOURCE_COUNT] = {};
	const uint64_t counts[RESOURCE_COUNT] = { p_capacity, p_capacity, 8, 16, 8, p_surface_count, 224 + uint64_t(p_surface_count) * 144 };
	const uint64_t strides[RESOURCE_COUNT] = { 192, 192, 4, 4, 4, 20, 1 };
	uint64_t planned_bytes = 0;
	for (uint32_t i = 0; i < RESOURCE_COUNT; ++i) {
		const Error size_error = ExternalOutputConfig::checked_buffer_bytes(counts[i], strides[i], UINT32_MAX, bytes[i]);
		if (size_error != OK) {
			return size_error;
		}
		// Seven u32 extents sum safely in u64; no narrowing of total occurs.
		planned_bytes += bytes[i];
	}
	for (uint32_t i = 0; i < RESOURCE_COUNT; ++i) {
		resources[i].bytes = bytes[i];
	}
	total_bytes = planned_bytes;
	attempted = true;
	for (uint32_t i = 0; i < RESOURCE_COUNT; ++i) {
		if (resources[i].bytes == 0) {
			continue; // Capacity zero has no current/previous record allocation.
		}
		const BitField<RenderingDevice::StorageBufferUsage> usage = i == PROTECTED_COMMANDS ? BitField<RenderingDevice::StorageBufferUsage>(RenderingDevice::STORAGE_BUFFER_USAGE_DISPATCH_INDIRECT) : BitField<RenderingDevice::StorageBufferUsage>();
		creation_error = device._native_disposal_storage_create(resources[i].bytes, usage, resources[i].rid, resources[i].witness);
		if (creation_error != OK) {
			// Preserve original creation error and every completed prefix entry.
			// A busy/failed disposal is retryable; it cannot lose or reuse storage.
			request_retirement();
			return creation_error;
		}
	}
	return OK;
}

Error ExternalOutputStorage::request_retirement() {
	if (!device.is_main_instance || device.render_thread_id != Thread::get_caller_id()) {
		return ERR_UNAUTHORIZED;
	}
	// Mark future use closed even if the RD is temporarily busy. This component
	// never records native uses itself; owner retirement of actual uses is extra.
	retirement_requested = true;
	Error first_error = OK;
	for (uint32_t i = RESOURCE_COUNT; i > 0; --i) {
		Resource &resource = resources[i - 1];
		if (resource.rid.is_null()) {
			continue;
		}
		const Error error = device._native_disposal_free(resource.witness);
		if (error != OK && first_error == OK) {
			first_error = error;
		}
	}
	Report report;
	const Error observation = observe(report);
	return observation != OK ? observation : first_error;
}

Error ExternalOutputStorage::observe(Report &r_report) {
	if (!device.is_main_instance || device.render_thread_id != Thread::get_caller_id()) {
		return ERR_UNAUTHORIZED;
	}
	Report report;
	report.total_bytes = total_bytes;
	report.creation_error = creation_error;
	report.retirement_requested = retirement_requested;
	Error first_error = OK;
	for (uint32_t i = 0; i < RESOURCE_COUNT; ++i) {
		report.resources[i].bytes = resources[i].bytes;
		if (resources[i].rid.is_null()) {
			continue;
		}
		++report.created_count;
		const Error error = device._native_disposal_observe(resources[i].witness, report.resources[i].native);
		if (error != OK && first_error == OK) {
			first_error = error;
		}
		switch (report.resources[i].native.state) {
			case NativeDisposalWitness::State::LIVE: ++report.live_count; break;
			case NativeDisposalWitness::State::ENQUEUED: ++report.enqueued_count; break;
			case NativeDisposalWitness::State::RETURNED: ++report.returned_count; break;
			case NativeDisposalWitness::State::UNKNOWN:
				++report.unknown_count;
				/* omitted */
				break;
			case NativeDisposalWitness::State::EMPTY: break; // Failed/unauthorized observation.
		}
	}
	report.all_driver_returned = !unknown && first_error == OK && report.returned_count == report.created_count;
	r_report = report;
	return unknown ? ERR_INVALID_DATA : first_error;
}

Error ExternalOutputStorage::maintenance() {
	return device._native_disposal_maintenance();
}

Error ExternalOutputStorage::destroy_if_returned(ExternalOutputStorage *&p_storage) {
	if (!p_storage) {
		return OK;
	}
	Report report;
	const Error error = p_storage->observe(report);
	if (error != OK) {
		return error;
	}
	if (!report.all_driver_returned) {
		return ERR_BUSY;
	}
	delete p_storage;
	p_storage = nullptr;
	return OK;
}
} // namespace RendererRD
class TestExternalOutputPrefixAccess {
 using S=RendererRD::ExternalOutputStorage;
 using State=NativeDisposalWitness::State;
public:
 static void run(){
  {
   RenderingDevice rd;S*s=new S(rd);S::Report r;rd.render_thread_id=2;
   assert(s->allocate_instance192(1,1)==ERR_UNAUTHORIZED);
   assert(s->request_retirement()==ERR_UNAUTHORIZED);
   assert(s->observe(r)==ERR_UNAUTHORIZED&&S::destroy_if_returned(s)==ERR_UNAUTHORIZED);
   rd.render_thread_id=1;assert(s->observe(r)==OK&&!r.retirement_requested&&rd.creates==0);
   assert(S::destroy_if_returned(s)==OK&&!s);
  }
  static_assert(!std::is_constructible_v<S,RenderingDevice&>);
  static_assert(!std::is_destructible_v<S>);
  {
   RenderingDevice rd;rd.fail_on=3;S*s=new S(rd);S::Report r;
   assert(s->allocate_instance192(2,1)==ERR_CANT_CREATE);
   assert(rd.creates==3&&rd.bytes==std::vector<uint32_t>({384,384,32}));
   assert(s->observe(r)==OK&&r.created_count==2&&r.enqueued_count==2&&!r.all_driver_returned);
   assert(r.resources[0].native.rid==101&&r.resources[1].native.rid==102);
   assert(r.resources[0].native.serial==1001&&r.resources[1].native.serial==1002);
   assert(r.creation_error==ERR_CANT_CREATE&&r.retirement_requested);
   assert(s->allocate_instance192(1,1)==ERR_ALREADY_IN_USE);
   assert(S::destroy_if_returned(s)==ERR_BUSY&&s);
   rd.returned();assert(s->observe(r)==OK&&r.returned_count==2&&r.all_driver_returned);
   assert(S::destroy_if_returned(s)==OK&&!s);
  }
  {
   RenderingDevice rd;S*s=new S(rd);S::Report r;
   assert(s->allocate_instance192(0,2)==OK);
   assert(rd.bytes==std::vector<uint32_t>({32,64,32,40,512}));
   assert(rd.usages==std::vector<uint32_t>({0,0,0,1,0}));
   assert(s->observe(r)==OK&&r.created_count==5&&r.total_bytes==680);
   assert(r.resources[0].native.state==State::EMPTY&&r.resources[1].native.state==State::EMPTY);
   rd.busy=true;assert(s->request_retirement()==ERR_BUSY);assert(s->observe(r)==OK&&r.live_count==5);
   assert(s->maintenance()==ERR_BUSY&&rd.maintenance_calls==1);
   assert(!r.all_driver_returned&&s->allocate_instance192(0,2)==ERR_ALREADY_IN_USE);
   rd.busy=false;assert(s->request_retirement()==OK);assert(s->request_retirement()==OK);
   rd.returned();assert(S::destroy_if_returned(s)==OK&&!s);
  }
  {
   RenderingDevice rd;S*s=new S(rd);
   assert(s->allocate_instance192(UINT32_MAX,1)==ERR_INVALID_PARAMETER);
   assert(s->allocate_instance192(1,UINT32_MAX)==ERR_INVALID_PARAMETER);
   assert(s->allocate_instance192(1,0)==ERR_INVALID_PARAMETER&&rd.creates==0);
   assert(s->allocate_instance192(1u<<20,8)==OK);
   assert(rd.bytes==std::vector<uint32_t>({201326592,201326592,32,64,32,160,1376}));
   assert(s->request_retirement()==OK);rd.returned();assert(S::destroy_if_returned(s)==OK);
  }
  {
   RenderingDevice rd;S*s=new S(rd);S::Report r;
   assert(s->request_retirement()==OK);
   assert(s->allocate_instance192(1,1)==ERR_ALREADY_IN_USE&&rd.creates==0);
   assert(S::destroy_if_returned(s)==OK);
   rd.fail_on=1;s=new S(rd);assert(s->allocate_instance192(1,1)==ERR_CANT_CREATE);
   assert(s->observe(r)==OK&&r.created_count==0&&r.all_driver_returned);
   assert(s->allocate_instance192(1,1)==ERR_ALREADY_IN_USE);assert(S::destroy_if_returned(s)==OK);
  }
  {
   RenderingDevice rd;S*s=new S(rd);S::Report r;
   assert(s->allocate_instance192(0,1)==OK);
   rd.cells[0]->state=State::UNKNOWN;
   assert(s->request_retirement()==ERR_INVALID_DATA);
   assert(s->observe(r)==ERR_INVALID_DATA&&r.unknown_count==1&&r.enqueued_count==4&&!r.all_driver_returned);
   assert(S::destroy_if_returned(s)==ERR_INVALID_DATA&&s);
   assert(s->allocate_instance192(0,1)==ERR_ALREADY_IN_USE);
   // Artificial fake-port recovery cannot clear the component's sticky UNKNOWN.
   rd.cells[0]->state=State::ENQUEUED;rd.returned();
   assert(s->observe(r)==ERR_INVALID_DATA&&!r.all_driver_returned);
   assert(S::destroy_if_returned(s)==ERR_INVALID_DATA&&s);
   delete s; // Fixture teardown only; never a production unknown reset.
  }
 }
};
int main(){TestExternalOutputPrefixAccess::run();std::puts("PASS production source-body controls (mock mechanical port; no Engine/GPU)");}
