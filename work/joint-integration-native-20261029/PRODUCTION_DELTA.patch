+TEST_CASE("[ResourceSnapshot] nonlinear Curve sampling and admitted provenance count remain independent") {
+	Ref<Curve> c;
+	c.instantiate();
+	c->add_point(Vector2(0, 0), 0, 6);
+	c->add_point(Vector2(1, 0));
