+	CHECK(std::string(bytes, size) == "{\"kind\":\"start\"}\n{\"kind\":\"seal\"}\n");
+	CHECK(read(handles[0], bytes, sizeof(bytes)) == 0);
+	CHECK_FALSE(writer.publish("{}\n"));
+	::close(handles[0]);
+}
