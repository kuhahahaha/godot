+	SkinnedMeshCaptureTestCaptureWriter missing;
+	CHECK_FALSE(missing.start(-1));
+	int handles[2];
+	REQUIRE(pipe(handles) == 0);
+	::close(handles[0]);
+	SkinnedMeshCaptureTestCaptureWriter writer;
+	REQUIRE(writer.start(handles[1]));
+	CHECK(writer.publish("{}\n"));
+	writer.close();
+	CHECK(writer.failed());
+}
