+			cleanup = true;
+			cleanup_negative = 1;
+		}
+		if (arg == "--release-cleanup-missing-owner") {
+			cleanup = true;
+			cleanup_negative = 2;
+		}
+		if (arg == "--release-cleanup") {
+			cleanup = true;
+		}
+		if (arg == "--release-before") {
+			before = true;
+		}
