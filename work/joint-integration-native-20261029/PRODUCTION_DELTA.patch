+		for (uint64_t supported : { uint64_t(0), uint64_t(1) }) {
+			for (uint64_t requested : requests) {
+				CAPTURE(requested);
+				CAPTURE(supported);
+				CHECK(ShaderCompilePolicy::flags_valid(requested, supported) == (requested <= 1 && requested <= supported));
+			}
+		}
