+ auto no_dependents=[&](RID rid) { auto *set=rd->dependency_map.getptr(rid);return !set || set->is_empty(); };
+ auto enqueue=[&](QualificationPhysicalReturn &cell,uint32_t type)->uint32_t {
+  if(!cell.rid || cell.enqueued)return 0;
