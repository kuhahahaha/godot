+	c.instantiate();
+	double x[2] = { 0, 1 }, samples[2] = { 9, 9 };
+	AngeCurvePointV1 points[2] = {};
+	uint32_t pw = 9, sw = 9;
+	double lo = 9, hi = 9;
+	uint64_t rev = 0;
+	CHECK(ange_curve_snapshot_v1(c.ptr(), x, 2, nullptr, 0, samples, 2, &pw, &sw, &lo, &hi, &rev) == ANGE_CAPTURE_OK_V1);
+	CHECK(pw == 0);
+	CHECK(sw == 2);
+	CHECK(samples[0] == 0);
+	CHECK(samples[1] == 0);
