+		CHECK_EQ(extension->close_library(), ERR_BUSY);
+	}
+	CHECK_EQ(Access::binding_holders(*extension.ptr()), 0);
+	CHECK_EQ(registry.begin_quiesce(record), OK);
+	CHECK_EQ(extension->close_library(), OK);
