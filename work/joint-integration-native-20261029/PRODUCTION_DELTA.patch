+static String new_audit_path() {
+	Error error = OK;
+	Ref<FileAccess> temporary = FileAccess::create_temp(FileAccess::READ_WRITE, "godot_policy_audit", "jsonl", false, &error);
+	REQUIRE(error == OK);
+	String path = temporary->get_path_absolute();
+	temporary.unref();
+	return path;
+}
