+#include "drivers/vulkan/godot_vulkan.h"
+
+// Legacy blocking wait path only. The callbacks are original driver operations;
+// tests supply CPU operations to verify the native failure prefix without a GPU.
+// Maintenance poll/recycle must not call this blocking helper.
+struct VulkanFenceWaitResult {
+	enum Phase { QUERY, WAIT, RESET } phase = QUERY;
+	VkResult result = VK_SUCCESS;
+};
+
+template <typename Query, typename Wait, typename Reset>
+VulkanFenceWaitResult vulkan_fence_wait_and_reset(Query p_query, Wait p_wait, Reset p_reset) {
+	VkResult result = p_query();
+	if (result == VK_NOT_READY) {
+		result = p_wait();
+		if (result != VK_SUCCESS) { return { VulkanFenceWaitResult::WAIT, result }; }
+	}
+	if (result != VK_SUCCESS) { return { VulkanFenceWaitResult::QUERY, result }; }
+	return { VulkanFenceWaitResult::RESET, p_reset() };
+}
