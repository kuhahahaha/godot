+	if (std::strcmp(name, "device_exit_register_guard_v1") == 0) {
+		return true;
+	}
+	if (std::strcmp(name, "device_exit_borrow_guarded_library_v1") == 0) {
+		return true;
+	}
+	if (std::strcmp(name, "device_exit_borrow_initialize_level_v1") == 0) {
+		return true;
