class TestExternalOutputPrefixAccess {
 using S=RendererRD::ExternalOutputStorage;
 using State=NativeDisposalWitness::State;
public:
 static void run(){
  // Independent aggregate rule: only seven actual RETURNED observations can
  // destroy a seven-resource prefix. UNKNOWN is permanent at aggregate level.
  uint32_t combinations=0;
  for(uint32_t mask=0;mask<(1u<<14);++mask){
   RenderingDevice rd;S*s=new S(rd);assert(s->allocate_instance192(1,1)==OK);
   uint32_t live=0,enqueued=0,returned=0,unknown=0,code=mask;
   for(uint32_t i=0;i<7;++i){uint32_t digit=code&3;code>>=2;
    if(digit==0){rd.cells[i]->state=State::LIVE;++live;}
    if(digit==1){rd.cells[i]->state=State::ENQUEUED;++enqueued;}
    if(digit==2){rd.cells[i]->state=State::RETURNED;++returned;}
    if(digit==3){rd.cells[i]->state=State::UNKNOWN;++unknown;}
   }
   S::Report r;Error error=s->observe(r);
   assert(r.created_count==7&&r.live_count==live&&r.enqueued_count==enqueued&&r.returned_count==returned&&r.unknown_count==unknown);
   assert(error==(unknown?ERR_INVALID_DATA:OK));assert(r.all_driver_returned==(returned==7));
   Error destroyed=S::destroy_if_returned(s);
   assert(destroyed==(unknown?ERR_INVALID_DATA:returned==7?OK:ERR_BUSY));
   if(s)delete s; // Mock fixture teardown only, never a production cleanup path.
   ++combinations;
  }
  assert(combinations==16384);
  {
   RenderingDevice rd;S*s=new S(rd);S::Report r;
   assert(s->allocate_instance192(1,1)==OK);assert(s->request_retirement()==OK);rd.returned();
   rd.observe_fail_index=3;
   assert(s->observe(r)==ERR_UNAUTHORIZED);
   assert(r.created_count==7&&r.returned_count==6&&!r.all_driver_returned);
   assert(S::destroy_if_returned(s)==ERR_UNAUTHORIZED&&s);
   rd.observe_fail_index=-1;assert(S::destroy_if_returned(s)==OK&&!s);
  }
  {
   RenderingDevice rd;S*s=new S(rd);S::Report r;
   assert(s->allocate_instance192(1,1)==OK);
   rd.render_thread_id=2;r.created_count=777;r.all_driver_returned=true;
   assert(s->request_retirement()==ERR_UNAUTHORIZED);
   assert(s->observe(r)==ERR_UNAUTHORIZED&&r.created_count==777&&r.all_driver_returned);
   assert(S::destroy_if_returned(s)==ERR_UNAUTHORIZED&&s);
   rd.render_thread_id=1;assert(s->observe(r)==OK&&!r.retirement_requested&&r.live_count==7);
   rd.busy=true;
   for(uint32_t i=0;i<3;++i){assert(s->request_retirement()==ERR_BUSY);assert(s->observe(r)==OK&&r.live_count==7&&r.retirement_requested&&!r.all_driver_returned);}
   assert(s->allocate_instance192(1,1)==ERR_ALREADY_IN_USE);
   rd.busy=false;assert(s->request_retirement()==OK);rd.returned();assert(S::destroy_if_returned(s)==OK&&!s);
  }
  {
   RenderingDevice rd;rd.busy_after_create=2;S*s=new S(rd);S::Report r;
   assert(s->allocate_instance192(1,1)==ERR_BUSY);
   assert(rd.creates==2);assert(s->observe(r)==OK&&r.creation_error==ERR_BUSY&&r.live_count==2&&r.retirement_requested);
   assert(S::destroy_if_returned(s)==ERR_BUSY&&s);
   rd.busy=false;rd.busy_after_create=0;assert(s->request_retirement()==OK);rd.returned();
   assert(s->observe(r)==OK&&r.all_driver_returned&&r.creation_error==ERR_BUSY);
   assert(S::destroy_if_returned(s)==OK&&!s);
  }
  {
   RenderingDevice rd;S*s=new S(rd);S::Report r;
   assert(s->allocate_instance192(0,1)==OK);rd.cells[0]->state=State::UNKNOWN;
   assert(s->observe(r)==ERR_INVALID_DATA);for(auto&cell:rd.cells)cell->state=State::RETURNED;
   assert(s->observe(r)==ERR_INVALID_DATA&&r.returned_count==5&&r.unknown_count==0&&!r.all_driver_returned);
   assert(S::destroy_if_returned(s)==ERR_INVALID_DATA&&s);delete s;
  }
  std::puts("PASS 16384 state combinations + partial observation error + wrong RT + repeated busy + busy allocation prefix + sticky UNKNOWN (MOCK RD/witness only)");
 }
};
int main(){TestExternalOutputPrefixAccess::run();}
