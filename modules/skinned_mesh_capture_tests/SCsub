#!/usr/bin/env python
from misc.utility.scons_hints import *

Import("env")
Import("env_modules")

env_modules.add_source_files(env.modules_sources, "*.cpp")

if env["tests"]:
    # Module tests are linked into the tests library like other built-in
    # modules.  The old tests_sources path is not a Godot SCons environment
    # variable and would fail configuration before the test runner is built.
    env_modules.add_source_files(env.modules_sources, "tests/*.cpp")
