#!/usr/bin/env python
from misc.utility.scons_hints import *

Import("env")

env.add_source_files(
    env.servers_sources,
    [source for source in Glob("*.cpp") if str(source).split("/")[-1] != "render_capture_test_tracking.cpp"],
)
if env["tests"] and any(
    module in env.module_list for module in ("skinned_mesh_capture_tests", "particles_runtime_tests")
):
    env.add_source_files(env.servers_sources, "render_capture_test_tracking.cpp")

SConscript("dummy/SCsub")
SConscript("renderer_rd/SCsub")
SConscript("storage/SCsub")
